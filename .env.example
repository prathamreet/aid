# Aid Management System - Environment Configuration Template
# Copy this file to .env and update the values

# Application Secret Key (Change this in production!)
SECRET_KEY=your-secret-key-here

# MongoDB Configuration - Option 1 (Recommended)
# Separate host and database name for better flexibility
MONGO_HOST=mongodb+srv://username:password@cluster.mongodb.net
MONGO_DB_NAME=your_database_name

# MongoDB Configuration - Option 2 (Legacy)
# Complete URI (if you prefer the traditional way)
# Note: If both options are provided, Option 1 takes precedence
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/your_database_name

# Examples for different setups:

# For MongoDB Atlas:
# MONGO_HOST=mongodb+srv://username:password@cluster.mongodb.net
# MONGO_DB_NAME=production_db

# For local MongoDB:
# MONGO_HOST=mongodb://localhost:27017
# MONGO_DB_NAME=aid_management_local

# For Docker MongoDB:
# MONGO_HOST=mongodb://mongodb:27017
# MONGO_DB_NAME=aid_app

# For different environments:
# Development: MONGO_DB_NAME=aid_dev
# Testing: MONGO_DB_NAME=aid_test
# Staging: MONGO_DB_NAME=aid_staging  
# Production: MONGO_DB_NAME=aid_production